diff --git a/test/controllers/rooms/closeds_controller_test.rb b/test/controllers/rooms/closeds_controller_test.rb
index 504745d..9bfed38 100644
--- a/test/controllers/rooms/closeds_controller_test.rb
+++ b/test/controllers/rooms/closeds_controller_test.rb
@@ -50,6 +50,28 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:designers).reload.name, "New Name"
   end
 
+  test "update renames and sets the topic in one request" do
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "New Name", topic: "Kerning, mostly" }, user_ids: rooms(:designers).users.collect(&:id)
+    }
+
+    assert_redirected_to room_url(rooms(:designers))
+    assert_equal "New Name", rooms(:designers).reload.name
+    assert_equal "Kerning, mostly", rooms(:designers).topic
+  end
+
+  test "update rejects a topic longer than 120 characters and leaves memberships alone" do
+    assert_no_difference -> { rooms(:designers).reload.users.count } do
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: "New Name", topic: "a" * 121 }, user_ids: rooms(:designers).users.without(users(:jason)).collect(&:id)
+      }
+    end
+
+    assert_response :unprocessable_content
+    assert_nil rooms(:designers).reload.topic
+    assert_equal "Designers", rooms(:designers).name
+  end
+
   test "update an open room to be closed" do
     put rooms_closed_url(rooms(:pets)), params: { room: { name: "Doesn't matter" }, user_ids: [ users(:david).id, users(:jason).id ] }
     assert_equal rooms(:pets).memberships.count, 2
diff --git a/test/controllers/rooms/opens_controller_test.rb b/test/controllers/rooms/opens_controller_test.rb
index 680c2e1..76f25c2 100644
--- a/test/controllers/rooms/opens_controller_test.rb
+++ b/test/controllers/rooms/opens_controller_test.rb
@@ -53,6 +53,30 @@ class Rooms::OpensControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:pets).reload.name, "New Name"
   end
 
+  test "update renames and sets the topic in one request" do
+    put rooms_open_url(rooms(:pets)), params: { room: { name: "New Name", topic: "Cats, dogs, and the occasional gecko" } }
+
+    assert_redirected_to room_url(rooms(:pets))
+    assert_equal "New Name", rooms(:pets).reload.name
+    assert_equal "Cats, dogs, and the occasional gecko", rooms(:pets).topic
+  end
+
+  test "update rejects a topic longer than 120 characters" do
+    put rooms_open_url(rooms(:pets)), params: { room: { name: "New Name", topic: "a" * 121 } }
+
+    assert_response :unprocessable_content
+    assert_nil rooms(:pets).reload.topic
+  end
+
+  test "only admins or creators can set the topic" do
+    sign_in :jz
+
+    put rooms_open_url(rooms(:hq)), params: { room: { topic: "Sneaking this in" } }
+
+    assert_response :forbidden
+    assert_nil rooms(:hq).reload.topic
+  end
+
   test "update a closed room to be open" do
     put rooms_open_url(rooms(:designers)), params: { room: { name: "Doesn't matter" } }
     assert_equal rooms(:designers).memberships.count, User.count
diff --git a/test/models/room_test.rb b/test/models/room_test.rb
index b113726..c7a3e24 100644
--- a/test/models/room_test.rb
+++ b/test/models/room_test.rb
@@ -30,6 +30,28 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "a room without a topic is valid" do
+    assert rooms(:pets).topic.nil?
+    assert rooms(:pets).valid?
+  end
+
+  test "a topic of up to 120 characters is kept" do
+    topic = "a" * 120
+    rooms(:pets).update!(topic: topic)
+    assert_equal topic, rooms(:pets).reload.topic
+  end
+
+  test "a topic longer than 120 characters is rejected" do
+    assert_not rooms(:pets).update(topic: "a" * 121)
+    assert rooms(:pets).reload.topic.nil?
+  end
+
+  test "a blank topic is stored as no topic at all" do
+    rooms(:pets).update!(topic: "Cats, dogs, and the occasional gecko")
+    rooms(:pets).update!(topic: "   ")
+    assert_nil rooms(:pets).reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
