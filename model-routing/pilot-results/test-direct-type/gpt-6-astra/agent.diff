 require "test_helper"
 
 class Rooms::DirectTest < ActiveSupport::TestCase
+  test "direct rooms cannot become open or closed rooms" do
+    [ Rooms::Open, Rooms::Closed ].each do |room_type|
+      direct = rooms(:david_and_kevin).reload
+      room = direct.becomes!(room_type)
+
+      assert_not room.save, "A direct room must not become a #{room_type}"
+      assert_equal [ "can't be changed for a direct room" ], room.errors[:type]
+      assert_equal "Rooms::Direct", Room.find(direct.id).type
+      assert_equal [ users(:david).id, users(:kevin).id ].sort, direct.users.reload.pluck(:id).sort
+    end
+  end
+
   test "create room for same users" do
     room = Rooms::Direct.find_or_create_for([ users(:david), users(:kevin) ])
     assert room.users.include?(users(:david))
