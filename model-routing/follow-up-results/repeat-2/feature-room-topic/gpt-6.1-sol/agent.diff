diff --git a/test/controllers/rooms/closeds_controller_test.rb b/test/controllers/rooms/closeds_controller_test.rb
index 504745d..b19f388 100644
--- a/test/controllers/rooms/closeds_controller_test.rb
+++ b/test/controllers/rooms/closeds_controller_test.rb
@@ -5,6 +5,43 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     sign_in :david
   end
 
+  test "edit includes topic alongside the room name" do
+    rooms(:designers).update! topic: "Current discussion"
+
+    get edit_rooms_closed_url(rooms(:designers))
+
+    assert_response :success
+    assert_select "form" do
+      assert_select "input[name='room[name]']"
+      assert_select "input[name='room[topic]'][value='Current discussion'][maxlength='120']"
+    end
+  end
+
+  test "rename and set or clear the topic in the same request" do
+    [ "a" * 120, "" ].each do |topic|
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: "Updated name", topic: topic }, user_ids: rooms(:designers).user_ids
+      }
+
+      assert_redirected_to room_url(rooms(:designers))
+      assert_equal "Updated name", rooms(:designers).reload.name
+      assert_equal topic, rooms(:designers).topic
+    end
+  end
+
+  test "reject an oversized topic without saving the rename" do
+    room = rooms(:designers)
+    original_name = room.name
+    room.update! topic: "Existing topic"
+
+    assert_raises ActiveRecord::RecordInvalid do
+      put rooms_closed_url(room), params: { room: { name: "Rejected name", topic: "a" * 121 } }
+    end
+
+    assert_equal original_name, room.reload.name
+    assert_equal "Existing topic", room.topic
+  end
+
   test "show redirects to get general show" do
     get rooms_open_url(users(:david).rooms.closeds.last)
     assert_redirected_to room_url(users(:david).rooms.closeds.last)
@@ -59,10 +96,11 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     sign_in :jz
 
     assert_turbo_stream_broadcasts :rooms, count: 0 do
-      put rooms_closed_url(rooms(:designers)), params: { room: { name: "New Name" } }
+      put rooms_closed_url(rooms(:designers)), params: { room: { name: "New Name", topic: "Unauthorized topic" } }
     end
 
     assert_response :forbidden
+    assert_nil rooms(:designers).reload.topic
     assert rooms(:designers).reload.name, "Designers"
   end
 
