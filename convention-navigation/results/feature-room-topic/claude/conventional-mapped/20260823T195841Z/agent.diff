diff --git a/app/models/room.rb b/app/models/room.rb
index 20865fc..e78cafe 100644
--- a/app/models/room.rb
+++ b/app/models/room.rb
@@ -22,6 +22,12 @@ class Room < ApplicationRecord
 
   belongs_to :creator, class_name: "User", default: -> { Current.user }
 
+  # A topic is one short line about what the room is currently about: optional,
+  # but capped, since anything longer than a line belongs in a message instead.
+  MAX_TOPIC_LENGTH = 120
+
+  validates :topic, length: { maximum: MAX_TOPIC_LENGTH }
+
   validate :direct_rooms_keep_their_type, on: :update
 
   scope :opens,           -> { where(type: "Rooms::Open") }
