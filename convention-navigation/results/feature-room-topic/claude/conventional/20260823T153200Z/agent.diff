diff --git a/test/models/room_test.rb b/test/models/room_test.rb
index b113726..11fb46f 100644
--- a/test/models/room_test.rb
+++ b/test/models/room_test.rb
@@ -30,6 +30,41 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "topic is optional" do
+    room = rooms(:pets)
+    assert_nil room.topic
+    assert room.valid?
+  end
+
+  test "topic of up to 120 characters is saved" do
+    topic = "a" * Room::MAX_TOPIC_LENGTH
+
+    rooms(:pets).update!(topic: topic)
+    assert_equal topic, rooms(:pets).reload.topic
+  end
+
+  test "topic longer than 120 characters is rejected" do
+    room = rooms(:pets)
+
+    assert_not room.update(topic: "a" * (Room::MAX_TOPIC_LENGTH + 1))
+    assert room.errors.include?(:topic)
+    assert_nil room.reload.topic
+  end
+
+  test "blank topic is stored as no topic" do
+    rooms(:pets).update!(topic: "Anything with paws")
+    rooms(:pets).update!(topic: "   ")
+
+    assert_nil rooms(:pets).reload.topic
+  end
+
+  test "topic is stripped before it's validated" do
+    topic = "a" * Room::MAX_TOPIC_LENGTH
+
+    rooms(:pets).update!(topic: "  #{topic}  ")
+    assert_equal topic, rooms(:pets).reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
