diff --git a/test/models/room_test.rb b/test/models/room_test.rb
index b113726..7ed890a 100644
--- a/test/models/room_test.rb
+++ b/test/models/room_test.rb
@@ -1,6 +1,22 @@
 require "test_helper"
 
 class RoomTest < ActiveSupport::TestCase
+  test "topic is optional and limited to 120 characters" do
+    room = rooms(:watercooler)
+
+    assert room.update(topic: nil)
+    assert_nil room.reload.topic
+
+    [ "", "a" * 120 ].each do |topic|
+      assert room.update(topic: topic)
+      assert_equal topic, room.reload.topic
+    end
+
+    assert_not room.update(topic: "a" * 121)
+    assert room.errors.added?(:topic, :too_long, count: 120)
+    assert_equal "a" * 120, room.reload.topic
+  end
+
   test "grant membership to user" do
     rooms(:watercooler).memberships.grant_to(users(:kevin))
     assert rooms(:watercooler).users.include?(users(:kevin))
