diff --git a/test/models/room_test.rb b/test/models/room_test.rb
index b113726..56adce7 100644
--- a/test/models/room_test.rb
+++ b/test/models/room_test.rb
@@ -30,6 +30,35 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "a room is valid without a topic" do
+    assert rooms(:pets).topic.nil?
+    assert rooms(:pets).valid?
+  end
+
+  test "a blank topic is stored as no topic at all" do
+    rooms(:pets).update!(topic: "   ")
+    assert_nil rooms(:pets).reload.topic
+  end
+
+  test "a topic is stripped of surrounding whitespace" do
+    rooms(:pets).update!(topic: "  Cute animals  ")
+    assert_equal "Cute animals", rooms(:pets).reload.topic
+  end
+
+  test "a topic of the maximum length is accepted" do
+    rooms(:pets).topic = "x" * Room::MAX_TOPIC_LENGTH
+    assert rooms(:pets).valid?
+  end
+
+  test "a topic longer than the maximum length is rejected" do
+    rooms(:pets).topic = "x" * (Room::MAX_TOPIC_LENGTH + 1)
+
+    assert_not rooms(:pets).valid?
+    assert rooms(:pets).errors[:topic].any?
+    assert_not rooms(:pets).save
+    assert_nil rooms(:pets).reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
