diff --git a/test/controllers/rooms/closeds_controller_test.rb b/test/controllers/rooms/closeds_controller_test.rb
index 504745d..311ca2a 100644
--- a/test/controllers/rooms/closeds_controller_test.rb
+++ b/test/controllers/rooms/closeds_controller_test.rb
@@ -50,6 +50,62 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:designers).reload.name, "New Name"
   end
 
+  test "edit offers the topic on the same form as the name" do
+    get edit_rooms_closed_url(rooms(:designers))
+
+    assert_response :success
+    assert_select "form" do
+      assert_select "input#room_name"
+      assert_select "input#room_topic"
+    end
+  end
+
+  test "a member who can't administer the room sees the topic but can't edit it" do
+    sign_in :jz
+    rooms(:designers).update! topic: "Type crimes"
+
+    get edit_rooms_closed_url(rooms(:designers))
+
+    assert_response :success
+    assert_select "input#room_topic", count: 0
+    assert_select "p", text: /Type crimes/
+  end
+
+  test "update the name and topic together" do
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "New Name", topic: "Type crimes" }, user_ids: rooms(:designers).users.collect(&:id)
+    }
+
+    assert_redirected_to room_url(rooms(:designers))
+    assert_equal "New Name", rooms(:designers).reload.name
+    assert_equal "Type crimes", rooms(:designers).topic
+  end
+
+  test "update rejects a topic that's too long without renaming the room or revising memberships" do
+    assert_no_difference -> { rooms(:designers).reload.users.count } do
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: "New Name", topic: "T" * 121 }, user_ids: rooms(:designers).users.without(users(:jason)).collect(&:id)
+      }
+    end
+
+    assert_response :unprocessable_entity
+    assert_equal "Designers", rooms(:designers).reload.name
+    assert_nil rooms(:designers).topic
+  end
+
+  test "create with a topic" do
+    post rooms_closeds_url, params: { room: { name: "My New Room", topic: "Type crimes" }, user_ids: [ users(:david).id ] }
+    assert_equal "Type crimes", Room.last.topic
+  end
+
+  test "create rejects a topic that's too long" do
+    assert_no_difference -> { Room.count } do
+      post rooms_closeds_url, params: { room: { name: "My New Room", topic: "T" * 121 }, user_ids: [ users(:david).id ] }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
   test "update an open room to be closed" do
     put rooms_closed_url(rooms(:pets)), params: { room: { name: "Doesn't matter" }, user_ids: [ users(:david).id, users(:jason).id ] }
     assert_equal rooms(:pets).memberships.count, 2
