diff --git a/test/controllers/rooms/closeds_controller_test.rb b/test/controllers/rooms/closeds_controller_test.rb
index 504745d..31c3917 100644
--- a/test/controllers/rooms/closeds_controller_test.rb
+++ b/test/controllers/rooms/closeds_controller_test.rb
@@ -87,4 +87,19 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
       assert_redirected_to root_url
     end
   end
+  test "update name and topic together and reject an oversized topic" do
+    room = rooms(:designers)
+    params = { room: { name: "Renamed", topic: "Current discussion" }, user_ids: room.user_ids }
+    put rooms_closed_url(room), params: params
+    assert_redirected_to room_url(room)
+    assert_equal [ "Renamed", "Current discussion" ], room.reload.values_at(:name, :topic)
+
+    params[:room][:name] = "Not saved"
+    params[:room][:topic] = "x" * 121
+    put rooms_closed_url(room), params: params
+    assert_response :unprocessable_entity
+    assert_equal [ "Renamed", "Current discussion" ], room.reload.values_at(:name, :topic)
+    assert_select "input[name='room[topic]']"
+  end
+
 end
