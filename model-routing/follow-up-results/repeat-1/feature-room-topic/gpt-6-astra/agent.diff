diff --git a/test/models/room_test.rb b/test/models/room_test.rb
index b113726..f5f79ca 100644
--- a/test/models/room_test.rb
+++ b/test/models/room_test.rb
@@ -1,6 +1,30 @@
 require "test_helper"
 
 class RoomTest < ActiveSupport::TestCase
+  test "topic is optional and accepts up to 120 characters" do
+    room = rooms(:watercooler)
+
+    [ nil, "", "日" * 120 ].each do |topic|
+      assert room.update(topic: topic)
+      if topic.nil?
+        assert_nil room.reload.topic
+      else
+        assert_equal topic, room.reload.topic
+      end
+    end
+  end
+
+  test "overlong topic is rejected without saving other changes" do
+    room = rooms(:watercooler)
+    original_name = room.name
+    room.update!(topic: "Current topic")
+
+    assert_not room.update(name: "Changed name", topic: "a" * 121)
+    assert_includes room.errors[:topic], "is too long (maximum is 120 characters)"
+    assert_equal "Current topic", room.reload.topic
+    assert_equal original_name, room.name
+  end
+
   test "grant membership to user" do
     rooms(:watercooler).memberships.grant_to(users(:kevin))
     assert rooms(:watercooler).users.include?(users(:kevin))
