+    assert_equal "Design crits", rooms(:designers).topic
+  end
+
+  test "update rejects a topic longer than the maximum length, leaving memberships alone" do
+    assert_no_difference -> { rooms(:designers).reload.users.count } do
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: "New Name", topic: "a" * (Room::MAX_TOPIC_LENGTH + 1) }, user_ids: [ users(:david).id ]
+      }
+    end
+
+    assert_response :unprocessable_content
+    assert_equal "Designers", rooms(:designers).reload.name
+    assert_nil rooms(:designers).topic
+  end
+
+  test "create with a topic" do
+    post rooms_closeds_url, params: {
+      room: { name: "My New Room", topic: "Design crits" }, user_ids: [ users(:david).id, users(:kevin).id ]
