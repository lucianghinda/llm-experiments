@@ -30,6 +30,54 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "topic is optional" do
+    room = rooms(:watercooler)
+    assert_nil room.topic
+
+    assert room.valid?
+    assert room.update(topic: "Anything but work")
+    assert_equal "Anything but work", room.reload.topic
+  end
+
+  test "clearing a topic leaves the room without one" do
+    room = rooms(:watercooler)
+    room.update! topic: "Anything but work"
+
+    assert room.update(topic: "   ")
+    assert_nil room.reload.topic
+  end
+
+  test "topic is squeezed onto a single line" do
+    room = rooms(:watercooler)
+    room.update! topic: "  Anything\nbut   work  "
+
+    assert_equal "Anything but work", room.reload.topic
+  end
+
+  test "topic of the maximum length is accepted" do
+    room = rooms(:watercooler)
+    topic = "t" * Room::MAXIMUM_TOPIC_LENGTH
+
+    assert room.update(topic: topic)
+    assert_equal topic, room.reload.topic
+  end
+
+  test "topic longer than the maximum length is rejected rather than saved" do
+    room = rooms(:watercooler)
+
+    assert_not room.update(topic: "t" * (Room::MAXIMUM_TOPIC_LENGTH + 1))
+    assert room.errors[:topic].present?
+    assert_nil room.reload.topic
+  end
+
+  test "room can't be created with a topic longer than the maximum length" do
+    assert_no_difference -> { Room.count } do
+      assert_raises ActiveRecord::RecordInvalid do
+        Rooms::Open.create_for({ name: "Hello!", topic: "t" * (Room::MAXIMUM_TOPIC_LENGTH + 1) }, users: users(:david))
+      end
+    end
+  end
+
