+  test "edit offers a topic field alongside the name field" do
+    rooms(:designers).update!(topic: "Design crits")
+
+    get edit_rooms_closed_url(rooms(:designers))
+
+    assert_response :success
+    assert_select "form input#room_name[name=?]", "room[name]"
+    assert_select "form input#room_topic[name=?][value=?]", "room[topic]", "Design crits"
+  end
+
+  test "update sets the topic through the same request that renames the room" do
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "New Name", topic: "Design crits" }, user_ids: rooms(:designers).users.collect(&:id)
