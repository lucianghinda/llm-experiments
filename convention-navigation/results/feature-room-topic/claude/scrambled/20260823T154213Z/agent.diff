--- a/test/suite/endpoints/rooms/closeds_controller_test.rb
+++ b/test/suite/endpoints/rooms/closeds_controller_test.rb
@@ -50,6 +50,41 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:designers).reload.name, "New Name"
   end
 
+  test "renaming a room sets its topic in the same request" do
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "New Name", topic: "Where the pixels get pushed" }, user_ids: rooms(:designers).users.collect(&:id)
+    }
+
+    assert_redirected_to room_url(rooms(:designers))
+    assert_equal "New Name", rooms(:designers).reload.name
+    assert_equal "Where the pixels get pushed", rooms(:designers).reload.topic
+  end
+
+  test "update rejects a topic longer than the maximum length, memberships included" do
+    rooms(:designers).update! topic: "Where the pixels get pushed"
+
+    assert_no_difference -> { rooms(:designers).reload.users.count } do
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: "New Name", topic: "T" * (Room::MAX_TOPIC_LENGTH + 1) },
+        user_ids: rooms(:designers).users.without(users(:jason)).collect(&:id)
+      }
+    end
+
+    assert_response :unprocessable_content
+    assert_equal "Where the pixels get pushed", rooms(:designers).reload.topic
+    assert_equal "Designers", rooms(:designers).reload.name
+  end
+
+  test "create rejects a topic longer than the maximum length" do
+    assert_no_difference -> { Room.count } do
+      post rooms_closeds_url, params: {
+        room: { name: "My New Room", topic: "T" * (Room::MAX_TOPIC_LENGTH + 1) }, user_ids: [ users(:david).id ]
+      }
+    end
+
+    assert_response :unprocessable_content
+  end
+
   test "update an open room to be closed" do
     put rooms_closed_url(rooms(:pets)), params: { room: { name: "Doesn't matter" }, user_ids: [ users(:david).id, users(:jason).id ] }
     assert_equal rooms(:pets).memberships.count, 2
