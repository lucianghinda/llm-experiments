--- a/test/suite/persistence/room_test.rb
+++ b/test/suite/persistence/room_test.rb
@@ -30,6 +30,37 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "a room is valid without a topic" do
+    assert rooms(:pets).topic.nil?
+    assert rooms(:pets).valid?
+  end
+
+  test "topic is kept to one line" do
+    room = rooms(:pets)
+    room.update! topic: "  Pets  of\n  the office  "
+    assert_equal "Pets of the office", room.reload.topic
+  end
+
+  test "an emptied topic is stored as no topic" do
+    room = rooms(:hq)
+    room.update! topic: "   "
+    assert_nil room.reload.topic
+  end
+
+  test "a topic of the maximum length is accepted" do
+    room = rooms(:pets)
+    room.update! topic: "x" * Room::MAX_TOPIC_LENGTH
+    assert_equal "x" * Room::MAX_TOPIC_LENGTH, room.reload.topic
+  end
+
+  test "a topic longer than the maximum length is rejected" do
+    room = rooms(:pets)
+
+    assert_not room.update(topic: "x" * (Room::MAX_TOPIC_LENGTH + 1))
+    assert room.errors[:topic].present?
+    assert_nil room.reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
