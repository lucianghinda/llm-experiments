 class Room < ApplicationRecord
+  # A topic is a one-line summary of what a room is currently about rather than a
+  # second description: long enough for a sentence, short enough to sit next to the
+  # room's name without pushing everything else off the screen.
+  MAXIMUM_TOPIC_LENGTH = 120
+
   has_many :memberships, dependent: :delete_all do
     def grant_to(users)
       room = proxy_association.owner
@@ -22,6 +27,11 @@ class Room < ApplicationRecord
 
   belongs_to :creator, class_name: "User", default: -> { Current.user }
 
+  # Optional, so only the length is checked. A blank one is normalised away rather
+  # than stored, so a room either has a topic or has none.
+  normalizes :topic, with: ->(topic) { topic.strip.presence }
+  validates :topic, length: { maximum: MAXIMUM_TOPIC_LENGTH }
+
   validate :direct_rooms_keep_their_type, on: :update
 
   scope :opens,           -> { where(type: "Rooms::Open") }
diff --git a/test/suite/endpoints/rooms/closeds_controller_test.rb b/test/suite/endpoints/rooms/closeds_controller_test.rb
