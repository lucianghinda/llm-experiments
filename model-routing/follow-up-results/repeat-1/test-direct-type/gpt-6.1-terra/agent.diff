+  test "a direct room cannot change its type" do
+    [ "Rooms::Open", "Rooms::Closed" ].each do |type|
+      room = Room.find(rooms(:david_and_kevin).id)
+
+      assert_not room.update(type: type)
+      assert_equal "Rooms::Direct", Room.find(room.id).type
+    end
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
