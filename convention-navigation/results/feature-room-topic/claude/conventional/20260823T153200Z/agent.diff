diff --git a/test/controllers/rooms/closeds_controller_test.rb b/test/controllers/rooms/closeds_controller_test.rb
index 504745d..1e85cfd 100644
--- a/test/controllers/rooms/closeds_controller_test.rb
+++ b/test/controllers/rooms/closeds_controller_test.rb
@@ -50,6 +50,47 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:designers).reload.name, "New Name"
   end
 
+  test "create with a topic" do
+    post rooms_closeds_url, params: {
+      room: { name: "My New Room", topic: "Just us" }, user_ids: [ users(:david).id, users(:kevin).id ]
+    }
+
+    assert_equal "Just us", Room.last.topic
+  end
+
+  test "create rejects a topic longer than the maximum" do
+    assert_no_difference -> { Room.count } do
+      post rooms_closeds_url, params: {
+        room: { name: "My New Room", topic: "a" * (Room::MAX_TOPIC_LENGTH + 1) }, user_ids: [ users(:david).id ]
+      }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "update sets the topic alongside the name" do
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "New Name", topic: "Pixels and pushing them" }, user_ids: rooms(:designers).user_ids
+    }
+
+    assert_redirected_to room_url(rooms(:designers))
+    assert_equal "New Name", rooms(:designers).reload.name
+    assert_equal "Pixels and pushing them", rooms(:designers).reload.topic
+  end
+
+  test "update rejects a topic longer than the maximum, leaving the room and its memberships alone" do
+    assert_no_difference -> { rooms(:designers).reload.users.count } do
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: "New Name", topic: "a" * (Room::MAX_TOPIC_LENGTH + 1) },
+        user_ids: rooms(:designers).users.without(users(:jason)).collect(&:id)
+      }
+    end
+
+    assert_response :unprocessable_content
+    assert_equal "Designers", rooms(:designers).reload.name
+    assert_nil rooms(:designers).reload.topic
+  end
+
   test "update an open room to be closed" do
     put rooms_closed_url(rooms(:pets)), params: { room: { name: "Doesn't matter" }, user_ids: [ users(:david).id, users(:jason).id ] }
     assert_equal rooms(:pets).memberships.count, 2
diff --git a/test/controllers/rooms/opens_controller_test.rb b/test/controllers/rooms/opens_controller_test.rb
index 680c2e1..320faad 100644
--- a/test/controllers/rooms/opens_controller_test.rb
+++ b/test/controllers/rooms/opens_controller_test.rb
@@ -53,6 +53,57 @@ class Rooms::OpensControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:pets).reload.name, "New Name"
   end
 
+  test "create with a topic" do
+    post rooms_opens_url, params: { room: { name: "My New Room", topic: "Everything and nothing" } }
+    assert_equal "Everything and nothing", Room.last.topic
+  end
+
+  test "create rejects a topic longer than the maximum" do
+    assert_no_difference -> { Room.count } do
+      post rooms_opens_url, params: { room: { name: "My New Room", topic: "a" * (Room::MAX_TOPIC_LENGTH + 1) } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "update sets and changes the topic alongside the name" do
+    put rooms_open_url(rooms(:pets)), params: { room: { name: "New Name", topic: "Cats, mostly" } }
+    assert_redirected_to room_url(rooms(:pets))
+    assert_equal "New Name", rooms(:pets).reload.name
+    assert_equal "Cats, mostly", rooms(:pets).reload.topic
+
+    put rooms_open_url(rooms(:pets)), params: { room: { name: "New Name", topic: "Dogs too" } }
+    assert_equal "Dogs too", rooms(:pets).reload.topic
+  end
+
+  test "update clears the topic" do
+    rooms(:pets).update! topic: "Cats, mostly"
+
+    put rooms_open_url(rooms(:pets)), params: { room: { name: "All Pets", topic: "" } }
+
+    assert_redirected_to room_url(rooms(:pets))
+    assert_nil rooms(:pets).reload.topic
+  end
+
+  test "update rejects a topic longer than the maximum, leaving the room alone" do
+    assert_turbo_stream_broadcasts :rooms, count: 0 do
+      put rooms_open_url(rooms(:pets)), params: { room: { name: "New Name", topic: "a" * (Room::MAX_TOPIC_LENGTH + 1) } }
+    end
+
+    assert_response :unprocessable_content
+    assert_equal "All Pets", rooms(:pets).reload.name
+    assert_nil rooms(:pets).reload.topic
+  end
+
+  test "only admins or creators can set the topic" do
+    sign_in :jz
+
+    put rooms_open_url(rooms(:hq)), params: { room: { name: "HQ", topic: "Sneaking this in" } }
+
+    assert_response :forbidden
+    assert_nil rooms(:hq).reload.topic
+  end
+
   test "update a closed room to be open" do
     put rooms_open_url(rooms(:designers)), params: { room: { name: "Doesn't matter" } }
     assert_equal rooms(:designers).memberships.count, User.count
