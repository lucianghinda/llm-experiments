diff --git a/test/suite/persistence/room_test.rb b/test/suite/persistence/room_test.rb
index b113726..9a8fd5b 100644
--- a/test/suite/persistence/room_test.rb
+++ b/test/suite/persistence/room_test.rb
@@ -30,6 +30,26 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "a room without a topic is valid" do
+    room = rooms(:watercooler)
+    room.topic = nil
+    assert room.valid?
+  end
+
+  test "a topic of the maximum length is valid" do
+    room = rooms(:watercooler)
+    room.topic = "T" * Room::TOPIC_MAXIMUM_LENGTH
+    assert room.valid?
+  end
+
+  test "a topic longer than the maximum length is rejected" do
+    room = rooms(:watercooler)
+    room.topic = "T" * (Room::TOPIC_MAXIMUM_LENGTH + 1)
+
+    assert_not room.valid?
+    assert_includes room.errors.attribute_names, :topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
