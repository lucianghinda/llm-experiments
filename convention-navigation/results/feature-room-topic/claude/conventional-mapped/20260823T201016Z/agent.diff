     assert rooms(:designers).reload.name, "New Name"
   end
 
+  test "update renames the room and sets its topic in the same request" do
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "New Name", topic: "Shipping the new icon set" }, user_ids: rooms(:designers).users.collect(&:id)
+    }
+
+    assert_redirected_to room_url(rooms(:designers))
+    assert_equal "New Name", rooms(:designers).reload.name
+    assert_equal "Shipping the new icon set", rooms(:designers).topic
+  end
+
   test "update an open room to be closed" do
     put rooms_closed_url(rooms(:pets)), params: { room: { name: "Doesn't matter" }, user_ids: [ users(:david).id, users(:jason).id ] }
     assert_equal rooms(:pets).memberships.count, 2
diff --git a/test/controllers/rooms/opens_controller_test.rb b/test/controllers/rooms/opens_controller_test.rb
index 680c2e1..6babe68 100644
--- a/test/controllers/rooms/opens_controller_test.rb
+++ b/test/controllers/rooms/opens_controller_test.rb
@@ -53,6 +53,52 @@ class Rooms::OpensControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:pets).reload.name, "New Name"
   end
 
+  test "edit offers the topic alongside the name" do
+    rooms(:pets).update! topic: "Photos of our pets"
+
+    get edit_rooms_open_url(rooms(:pets))
+
+    assert_response :success
+    assert_select "input#room_name"
+    assert_select "input#room_topic[value=?]", "Photos of our pets"
+  end
+
+  test "edit shows the topic as plain text to those who can't administer the room" do
+    rooms(:hq).update! topic: "Where the buck stops"
+    sign_in :jz
+
+    get edit_rooms_open_url(rooms(:hq))
+
+    assert_response :success
+    assert_select "input#room_topic", count: 0
+    assert_select "p.txt-subtle", text: "Where the buck stops"
+  end
+
+  test "update renames the room and sets its topic in the same request" do
+    put rooms_open_url(rooms(:pets)), params: { room: { name: "New Name", topic: "Photos of our pets" } }
+
+    assert_redirected_to room_url(rooms(:pets))
+    assert_equal "New Name", rooms(:pets).reload.name
+    assert_equal "Photos of our pets", rooms(:pets).topic
+  end
+
+  test "update clears the topic" do
+    rooms(:pets).update! topic: "Photos of our pets"
+
+    put rooms_open_url(rooms(:pets)), params: { room: { name: "All Pets", topic: "" } }
+
+    assert_nil rooms(:pets).reload.topic
+  end
+
+  test "only admins or creators can set the topic" do
+    sign_in :jz
+
+    put rooms_open_url(rooms(:hq)), params: { room: { name: "HQ", topic: "Whatever I say it is" } }
+
+    assert_response :forbidden
+    assert_nil rooms(:hq).reload.topic
+  end
+
   test "update a closed room to be open" do
     put rooms_open_url(rooms(:designers)), params: { room: { name: "Doesn't matter" } }
     assert_equal rooms(:designers).memberships.count, User.count
