diff --git a/test/suite/persistence/room_test.rb b/test/suite/persistence/room_test.rb
index b113726..1e06bcf 100644
--- a/test/suite/persistence/room_test.rb
+++ b/test/suite/persistence/room_test.rb
@@ -30,6 +30,34 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "topic is optional" do
+    room = rooms(:watercooler)
+    room.topic = nil
+    assert room.save
+  end
+
+  test "topic is kept when it fits" do
+    room = rooms(:watercooler)
+    room.topic = "x" * Room::MAXIMUM_TOPIC_LENGTH
+    assert room.save
+    assert_equal "x" * Room::MAXIMUM_TOPIC_LENGTH, room.reload.topic
+  end
+
+  test "topic is rejected when it's longer than the maximum" do
+    room = rooms(:watercooler)
+    room.topic = "x" * (Room::MAXIMUM_TOPIC_LENGTH + 1)
+
+    assert_not room.save
+    assert room.errors.of_kind?(:topic, :too_long)
+    assert_nil room.reload.topic
+  end
+
+  test "a blank topic is stored as no topic at all" do
+    room = rooms(:watercooler)
+    room.update! topic: "   "
+    assert_nil room.reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
