diff --git a/test/controllers/rooms/closeds_controller_test.rb b/test/controllers/rooms/closeds_controller_test.rb
index 504745d..3a25c38 100644
--- a/test/controllers/rooms/closeds_controller_test.rb
+++ b/test/controllers/rooms/closeds_controller_test.rb
@@ -5,6 +5,50 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     sign_in :david
   end
 
+  test "edit includes topic alongside name" do
+    rooms(:designers).update!(topic: "Current discussion")
+    get edit_rooms_closed_url(rooms(:designers))
+
+    assert_response :success
+    assert_select 'form input[name="room[name]"]'
+    assert_select 'form input[name="room[topic]"][maxlength="120"][value="Current discussion"]'
+  end
+
+  test "update name and topic together and clear topic" do
+    room = rooms(:designers)
+    put rooms_closed_url(room), params: { room: { name: "New name", topic: "é" * 120 }, user_ids: room.user_ids }
+
+    assert_redirected_to room_url(room)
+    assert_equal "New name", room.reload.name
+    assert_equal "é" * 120, room.topic
+
+    put rooms_closed_url(room), params: { room: { name: "New name", topic: "" }, user_ids: room.user_ids }
+    assert_redirected_to room_url(room)
+    assert_equal "", room.reload.topic
+  end
+
+  test "overlong topic rejects the entire update" do
+    room = rooms(:designers)
+    original_name = room.name
+    original_members = room.user_ids.sort
+    put rooms_closed_url(room), params: { room: { name: "Rejected name", topic: "x" * 121 } }
+
+    assert_response :unprocessable_entity
+    assert_select '[role="alert"]', text: "Topic is too long (maximum is 120 characters)"
+    assert_equal original_name, room.reload.name
+    assert_nil room.topic
+    assert_equal original_members, room.user_ids.sort
+  end
+
+  test "topic update requires rename permission" do
+    sign_in :jz
+    room = rooms(:designers)
+    put rooms_closed_url(room), params: { room: { name: "Rejected name", topic: "Rejected topic" } }
+
+    assert_response :forbidden
+    assert_nil room.reload.topic
+  end
+
   test "show redirects to get general show" do
     get rooms_open_url(users(:david).rooms.closeds.last)
     assert_redirected_to room_url(users(:david).rooms.closeds.last)
