diff --git a/test/suite/persistence/rooms/direct_test.rb b/test/suite/persistence/rooms/direct_test.rb
index ab74efa..eaf90da 100644
--- a/test/suite/persistence/rooms/direct_test.rb
+++ b/test/suite/persistence/rooms/direct_test.rb
@@ -18,4 +18,18 @@ class Rooms::DirectTest < ActiveSupport::TestCase
     room = Rooms::Direct.find_or_create_for([ users(:david), users(:kevin) ])
     assert room.memberships.all? { |m| m.involved_in_everything? }
   end
+
+  test "can't be converted into a room type others can join" do
+    [ Rooms::Open, Rooms::Closed ].each do |type|
+      direct = Room.find(rooms(:david_and_kevin).id)
+      converted = direct.becomes!(type)
+
+      assert_not converted.save, "expected a direct room to refuse becoming #{type}"
+      assert converted.errors[:type].any?, "expected an error on :type when becoming #{type}"
+
+      reloaded = Room.find(direct.id)
+      assert_equal "Rooms::Direct", reloaded.type
+      assert_equal [ users(:david).id, users(:kevin).id ].sort, reloaded.user_ids.sort
+    end
+  end
 end
