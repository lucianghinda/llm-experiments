diff --git a/test/models/room_test.rb b/test/models/room_test.rb
index b113726..71d5898 100644
--- a/test/models/room_test.rb
+++ b/test/models/room_test.rb
@@ -30,6 +30,21 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "topic is optional" do
+    assert rooms(:pets).update(topic: nil)
+    assert_nil rooms(:pets).reload.topic
+  end
+
+  test "topic can't be longer than 120 characters" do
+    room = rooms(:pets)
+
+    assert room.update(topic: "T" * 120)
+
+    assert_not room.update(topic: "T" * 121)
+    assert_equal [ "is too long (maximum is 120 characters)" ], room.errors[:topic]
+    assert_equal "T" * 120, room.reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
