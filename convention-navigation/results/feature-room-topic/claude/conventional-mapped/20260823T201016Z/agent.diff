diff --git a/test/models/room_test.rb b/test/models/room_test.rb
index b113726..892f1af 100644
--- a/test/models/room_test.rb
+++ b/test/models/room_test.rb
@@ -30,6 +30,30 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "a room without a topic is valid" do
+    assert_nil rooms(:pets).topic
+    assert rooms(:pets).valid?
+  end
+
+  test "topic of up to 120 characters is accepted" do
+    rooms(:pets).update! topic: "T" * 120
+    assert_equal "T" * 120, rooms(:pets).reload.topic
+  end
+
+  test "topic longer than 120 characters is rejected" do
+    room = rooms(:pets)
+    room.topic = "T" * 121
+
+    assert_not room.valid?
+    assert room.errors.of_kind?(:topic, :too_long)
+    assert_nil room.reload.topic
+  end
+
+  test "blank topic is stored as none at all" do
+    rooms(:pets).update! topic: "   "
+    assert_nil rooms(:pets).reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
