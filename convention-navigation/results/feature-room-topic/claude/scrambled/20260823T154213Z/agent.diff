diff --git a/test/suite/persistence/room_test.rb b/test/suite/persistence/room_test.rb
index b113726..2028a26 100644
--- a/test/suite/persistence/room_test.rb
+++ b/test/suite/persistence/room_test.rb
@@ -30,6 +30,40 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "topic is optional" do
+    room = Rooms::Open.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:david) ])
+    assert_nil room.topic
+    assert room.valid?
+  end
+
+  test "topic of the maximum length is accepted" do
+    room = rooms(:pets)
+    assert room.update(topic: "T" * Room::MAX_TOPIC_LENGTH)
+    assert_equal "T" * Room::MAX_TOPIC_LENGTH, room.reload.topic
+  end
+
+  test "topic longer than the maximum length is rejected" do
+    room = rooms(:pets)
+
+    assert_not room.update(topic: "T" * (Room::MAX_TOPIC_LENGTH + 1))
+    assert room.errors[:topic].any?
+    assert_nil room.reload.topic
+  end
+
+  test "topic is cleared rather than blanked out" do
+    room = rooms(:pets)
+    room.update! topic: "Pets of Signal"
+
+    room.update! topic: "   "
+    assert_nil room.reload.topic
+  end
+
+  test "topic is stripped of surrounding whitespace" do
+    room = rooms(:pets)
+    room.update! topic: "  Pets of Signal  "
+    assert_equal "Pets of Signal", room.reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
