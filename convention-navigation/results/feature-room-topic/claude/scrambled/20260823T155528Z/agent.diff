+    assert_not room.valid?
+    assert_not room.save
+    assert_nil rooms(:pets).reload.topic
+  end
+
+  test "blank topic is stored as no topic" do
+    rooms(:pets).update!(topic: "  \n ")
+    assert_nil rooms(:pets).reload.topic
+  end
