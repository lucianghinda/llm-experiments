diff --git a/platform/core/entities/room.rb b/platform/core/entities/room.rb
index 20865fc..3ede448 100644
--- a/platform/core/entities/room.rb
+++ b/platform/core/entities/room.rb
@@ -1,4 +1,6 @@
 class Room < ApplicationRecord
+  MAX_TOPIC_LENGTH = 120
+
   has_many :memberships, dependent: :delete_all do
     def grant_to(users)
       room = proxy_association.owner
@@ -22,6 +24,10 @@ class Room < ApplicationRecord
 
   belongs_to :creator, class_name: "User", default: -> { Current.user }
 
+  # A topic is one line saying what the room is about right now. It's optional, and
+  # deliberately too short to hold a conversation in.
+  validates :topic, length: { maximum: MAX_TOPIC_LENGTH }
+
   validate :direct_rooms_keep_their_type, on: :update
 
   scope :opens,           -> { where(type: "Rooms::Open") }
diff --git a/test/suite/endpoints/rooms/closeds_controller_test.rb b/test/suite/endpoints/rooms/closeds_controller_test.rb
index 504745d..04d9cfa 100644
--- a/test/suite/endpoints/rooms/closeds_controller_test.rb
+++ b/test/suite/endpoints/rooms/closeds_controller_test.rb
@@ -50,6 +50,28 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:designers).reload.name, "New Name"
   end
 
+  test "update renames and sets the topic in the same request" do
+    put rooms_closed_url(rooms(:designers)), params: {
+      room: { name: "New Name", topic: "Where the design work happens" }, user_ids: rooms(:designers).users.collect(&:id)
+    }
+
+    assert_redirected_to room_url(rooms(:designers))
+    assert_equal "New Name", rooms(:designers).reload.name
+    assert_equal "Where the design work happens", rooms(:designers).topic
+  end
+
+  # RecordInvalid renders as 422 in production; test.rb re-raises it instead.
+  test "update rejects a topic that's too long" do
+    assert_raises ActiveRecord::RecordInvalid do
+      put rooms_closed_url(rooms(:designers)), params: {
+        room: { name: "New Name", topic: "T" * (Room::MAX_TOPIC_LENGTH + 1) }, user_ids: rooms(:designers).users.collect(&:id)
+      }
+    end
+
+    assert_nil rooms(:designers).reload.topic
+    assert_equal "Designers", rooms(:designers).name
+  end
+
   test "update an open room to be closed" do
     put rooms_closed_url(rooms(:pets)), params: { room: { name: "Doesn't matter" }, user_ids: [ users(:david).id, users(:jason).id ] }
     assert_equal rooms(:pets).memberships.count, 2
diff --git a/test/suite/endpoints/rooms/opens_controller_test.rb b/test/suite/endpoints/rooms/opens_controller_test.rb
index 680c2e1..30a5d83 100644
--- a/test/suite/endpoints/rooms/opens_controller_test.rb
+++ b/test/suite/endpoints/rooms/opens_controller_test.rb
@@ -53,6 +53,55 @@ class Rooms::OpensControllerTest < ActionDispatch::IntegrationTest
     assert rooms(:pets).reload.name, "New Name"
   end
 
+  test "edit offers the topic alongside the name to those who can administer the room" do
+    rooms(:pets).update! topic: "Pictures of our pets"
+
+    get edit_rooms_open_url(rooms(:pets))
+    assert_select "#room_name[value=?]", "All Pets"
+    assert_select "#room_topic[value=?][maxlength=?]", "Pictures of our pets", Room::MAX_TOPIC_LENGTH.to_s
+  end
+
+  test "edit shows the topic without a field to those who can't administer the room" do
+    rooms(:hq).update! topic: "Company announcements"
+    sign_in :jz
+
+    get edit_rooms_open_url(rooms(:hq))
+    assert_select "#room_topic", count: 0
+    assert_select "p", text: /Company announcements/
+  end
+
+  test "update renames and sets the topic in the same request" do
+    put rooms_open_url(rooms(:pets)), params: { room: { name: "New Name", topic: "Pictures of our pets" } }
+
+    assert_redirected_to room_url(rooms(:pets))
+    assert_equal "New Name", rooms(:pets).reload.name
+    assert_equal "Pictures of our pets", rooms(:pets).topic
+  end
+
+  # RecordInvalid renders as 422 in production; test.rb re-raises it instead.
+  test "update rejects a topic that's too long" do
+    assert_raises ActiveRecord::RecordInvalid do
+      put rooms_open_url(rooms(:pets)), params: { room: { name: "New Name", topic: "T" * (Room::MAX_TOPIC_LENGTH + 1) } }
+    end
+
+    assert_nil rooms(:pets).reload.topic
+    assert_equal "All Pets", rooms(:pets).name
+  end
+
+  test "only admins or creators can set the topic" do
+    sign_in :jz
+
+    put rooms_open_url(rooms(:hq)), params: { room: { name: "HQ", topic: "Sneaking a topic in" } }
+
+    assert_response :forbidden
+    assert_nil rooms(:hq).reload.topic
+  end
+
+  test "create with a topic" do
+    post rooms_opens_url, params: { room: { name: "My New Room", topic: "What we're up to" } }
+    assert_equal "What we're up to", Room.last.topic
+  end
+
   test "update a closed room to be open" do
     put rooms_open_url(rooms(:designers)), params: { room: { name: "Doesn't matter" } }
     assert_equal rooms(:designers).memberships.count, User.count
