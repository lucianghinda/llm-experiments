--- a/test/controllers/rooms/closeds_controller_test.rb
+++ b/test/controllers/rooms/closeds_controller_test.rb
@@ -5,6 +5,46 @@ class Rooms::ClosedsControllerTest < ActionDispatch::IntegrationTest
     sign_in :david
   end
 
+  test "edit includes topic in the rename form" do
+    rooms(:designers).update!(topic: "Current topic")
+
+    get edit_rooms_closed_url(rooms(:designers))
+
+    assert_response :success
+    assert_select "form" do
+      assert_select "input[name='room[name]']"
+      assert_select "input[name='room[topic]'][maxlength='120'][value='Current topic']"
+    end
+  end
+
+  test "rename and set or clear topic in the same request" do
+    room = rooms(:designers)
+
+    [ "a" * 120, "New topic", "" ].each do |topic|
+      put rooms_closed_url(room), params: {
+        room: { name: "Renamed room", topic: topic }, user_ids: room.user_ids
+      }
+
+      assert_redirected_to room_url(room)
+      assert_equal "Renamed room", room.reload.name
+      assert_equal topic, room.topic
+    end
+  end
+
+  test "overlong topic rejects the rename request" do
+    room = rooms(:designers)
+    original_name = room.name
+    original_user_ids = room.user_ids.sort
+
+    assert_raises ActiveRecord::RecordInvalid do
+      put rooms_closed_url(room), params: { room: { name: "Rejected name", topic: "a" * 121 } }
+    end
+
+    assert_equal original_name, room.reload.name
+    assert_nil room.topic
+    assert_equal original_user_ids, room.user_ids.sort
+  end
+
   test "show redirects to get general show" do
     get rooms_open_url(users(:david).rooms.closeds.last)
     assert_redirected_to room_url(users(:david).rooms.closeds.last)
