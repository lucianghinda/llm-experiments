diff --git a/platform/core/entities/room.rb b/platform/core/entities/room.rb
index 20865fc..6dd93b5 100644
--- a/platform/core/entities/room.rb
+++ b/platform/core/entities/room.rb
@@ -1,4 +1,8 @@
 class Room < ApplicationRecord
+  # A topic is a single line saying what the room is about right now. It's optional,
+  # and short enough to sit next to the room name without wrapping.
+  MAXIMUM_TOPIC_LENGTH = 120
+
   has_many :memberships, dependent: :delete_all do
     def grant_to(users)
       room = proxy_association.owner
@@ -22,6 +26,13 @@ class Room < ApplicationRecord
 
   belongs_to :creator, class_name: "User", default: -> { Current.user }
 
+  # A topic arrives from a single-line text field, so whitespace around it carries no
+  # meaning, and a field cleared to "" means the room has no topic rather than an
+  # empty one.
+  normalizes :topic, with: ->(topic) { topic.gsub(/\s+/, " ").strip.presence }
+
+  validates :topic, length: { maximum: MAXIMUM_TOPIC_LENGTH }
+
   validate :direct_rooms_keep_their_type, on: :update
 
   scope :opens,           -> { where(type: "Rooms::Open") }
