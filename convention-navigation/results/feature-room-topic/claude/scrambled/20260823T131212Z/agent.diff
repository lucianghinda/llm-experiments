diff --git a/test/suite/persistence/room_test.rb b/test/suite/persistence/room_test.rb
index b113726..b120ad7 100644
--- a/test/suite/persistence/room_test.rb
+++ b/test/suite/persistence/room_test.rb
@@ -30,6 +30,34 @@ class RoomTest < ActiveSupport::TestCase
     assert Rooms::Closed.new.closed?
   end
 
+  test "a room is valid without a topic" do
+    room = Rooms::Open.create!(name: "Hello!", creator: users(:david))
+    assert_nil room.topic
+  end
+
+  test "a topic is kept up to the maximum length" do
+    topic = "T" * Room::MAXIMUM_TOPIC_LENGTH
+    room = Rooms::Open.create!(name: "Hello!", creator: users(:david), topic: topic)
+    assert_equal topic, room.reload.topic
+  end
+
+  test "a topic longer than the maximum is rejected" do
+    room = Rooms::Open.new(name: "Hello!", creator: users(:david), topic: "T" * (Room::MAXIMUM_TOPIC_LENGTH + 1))
+
+    assert_not room.valid?
+    assert_predicate room.errors[:topic], :any?
+    assert_no_difference -> { Room.count } do
+      assert_not room.save
+    end
+  end
+
+  test "an existing topic survives an attempt to replace it with one that's too long" do
+    rooms(:hq).update! topic: "Where we plan the day"
+
+    assert_not rooms(:hq).update(topic: "T" * (Room::MAXIMUM_TOPIC_LENGTH + 1))
+    assert_equal "Where we plan the day", rooms(:hq).reload.topic
+  end
+
   test "default involvement for new users" do
     room = Rooms::Closed.create_for({ name: "Hello!", creator: users(:david) }, users: [ users(:kevin), users(:david) ])
     assert room.memberships.all? { |m| m.involved_in_mentions? }
